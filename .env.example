# StudNova — variables de entorno de ejemplo
# Copia este archivo como .env y completa los valores.

GEMINI_API_KEY=
GROQ_API_KEY=

# Local (PostgreSQL del docker-compose en el puerto 5433)
DATABASE_URL=postgresql://postgres:1234@localhost:5433/studnova

# Seguridad de la API
# Genera la clave con: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Orígenes permitidos por CORS (separados por coma, sin espacios)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
